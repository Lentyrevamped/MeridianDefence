# Meridian defaults (users can still change them; stable keys only)
[org.gnome.desktop.interface]
color-scheme='prefer-dark'
accent-color='blue'
clock-show-weekday=true

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/meridian/meridian-light.png'
picture-uri-dark='file:///usr/share/backgrounds/meridian/meridian-dark.png'
picture-options='zoom'
primary-color='#0E141B'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/meridian/meridian-dark.png'
picture-options='zoom'
primary-color='#0E141B'

[org.gnome.login-screen]
logo=''

# Dock (default only; a user's own dock order is kept)
[org.gnome.shell]
favorite-apps=['com.google.Chrome.desktop', 'com.brave.Browser.desktop', 'org.meridian.ClaudeWeb.desktop', 'dev.vencord.Vesktop.desktop', 'com.spotify.Client.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Ptyxis.desktop', 'org.meridian.DriveSync.desktop', 'io.github.kolunmi.Bazaar.desktop']

# Terminal (Ptyxis): copy/paste on Ctrl+C / Ctrl+V like Windows. Users can change it in Ptyxis > Keyboard Shortcuts.
[org.gnome.Ptyxis.Shortcuts]
copy-clipboard='<ctrl>c'
paste-clipboard='<ctrl>v'
