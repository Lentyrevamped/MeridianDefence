# Meridian OS boot theme (Plymouth script module), Graphite design (tokens: /usr/share/meridian/tokens.css).
# States: intro -> pin -> wait -> splash. Flat #0E0E0F, centred column (mark, title, field), fades only:
# 320 ms screen crossfades with an 8 px rise, 120 ms dot fades with a 3 px rise, no shake, no glow.
# Disk unlock is stock (TPM+PIN, recovery key); this theme only draws the prompt. No Ledger at boot.
# Art is rendered at 1.25x (GNOME's 125 % on an 1800 px panel) and scaled by S for other panels. No fonts in the initrd.

Window.SetBackgroundTopColor(0.0549, 0.0549, 0.0588);
Window.SetBackgroundBottomColor(0.0549, 0.0549, 0.0588);
W = Window.GetWidth(); H = Window.GetHeight(); X0 = Window.GetX(); Y0 = Window.GetY();
S = H / 1800; if (S > 1.6) S = 1.6;
CX = X0 + W / 2; CY = Y0 + H / 2;
U = 1.25 * S;                                      # one logical px of the design on this screen
FPS = 50;

fun ld(name) { ld_im = Image(name + ".png"); if (S < 0.999 || S > 1.001) ld_im = ld_im.Scale(Math.Int(ld_im.GetWidth() * S + 0.5), Math.Int(ld_im.GetHeight() * S + 0.5)); return ld_im; }
fun mk(img, z) { mk_s = Sprite(img); mk_s.SetZ(z); mk_s.SetOpacity(0); return mk_s; }
fun clamp01(x) { if (x < 0) return 0; if (x > 1) return 1; return x; }
fun ease(x) { x = clamp01(x); return 1 - (1 - x) * (1 - x) * (1 - x); }     # ~cubic-bezier(.2,0,0,1)
fun easein(x) { x = clamp01(x); return x * x * x; }                          # ~cubic-bezier(.4,0,1,1), exits
fun at(sp, img, cx, cy, op) { sp.SetImage(img); sp.SetX(Math.Int(cx - img.GetWidth() / 2)); sp.SetY(Math.Int(cy - img.GetHeight() / 2)); sp.SetOpacity(op); }

# ---- assets ----
i_mark = ld("mark24"); i_mark42 = ld("mark42"); i_tpin = ld("title-pin"); i_tkey = ld("title-key");
i_fld = ld("field"); i_fld_err = ld("field-err"); i_dot = ld("dot");
i_epin = ld("err-pin"); i_ekey = ld("err-key"); i_fpin = ld("foot-pin"); i_fkey = ld("foot-key");
i_word = ld("wordmark"); i_track = Image("track.png"); i_seg = Image("seg.png");

# ---- layout (logical px from the centre). Column: mark 24, gap 18, title 24, gap 18, field 42 ----
C_MARK = -63 + 12; C_TITLE = -63 + 42 + 12; C_FLD = -63 + 84 + 21; C_HINT = C_FLD + 21 + 10 + 9;
SP_MARK = -(42 + 26 + 22 + 26 + 2) / 2 + 21; SP_WORD = SP_MARK + 21 + 26 + 11; SP_TRACK = SP_WORD + 11 + 26 + 1;
TRK_W = 130; SEG_W = 40;

# ---- sprites ----
s_mark = mk(i_mark, 10); s_title = mk(i_tpin, 10); s_fld = mk(i_fld, 10); s_fld_err = mk(i_fld_err, 11);
s_hint = mk(i_epin, 10); s_foot = mk(i_fpin, 10);
s_mark42 = mk(i_mark42, 10); s_word = mk(i_word, 10); s_track = mk(i_track, 10); s_seg = mk(i_seg, 11);
ndots = 0;

# ---- state ----
mode = "intro"; tm = 0; t_mode = 0;
bullets = 0; submitted = 0; err = 0; t_err = 99; passmode = 0; last_prompt = "";
pin_op = 0; spl_op = 0; pin_seen = 0;
fun set_mode(m) { global.mode = m; global.t_mode = 0; }

# ---- callbacks ----
fun password_cb(prompt, b) {
  if (mode != "pin") {
    # Asked again with the same prompt after an answer = that answer was wrong. A different prompt (recovery key after
    # the PIN failed) is a new question, not an error. Must not depend on timing: the TPM check can take a while.
    if (submitted && prompt == last_prompt) { global.err = 1; global.t_err = 0; } else global.err = 0;
    global.submitted = 0;
    set_mode("pin");
  }
  global.last_prompt = prompt; global.pin_seen = 1;
  global.passmode = 1; pj = 0; while (prompt.CharAt(pj + 2) != "") { if (prompt.CharAt(pj) == "P" && prompt.CharAt(pj + 1) == "I" && prompt.CharAt(pj + 2) == "N") global.passmode = 0; pj++; }
  if (b > bullets) { for (k = bullets; k < b; k++) global.dt[k] = 0; }
  global.bullets = b;
}
Plymouth.SetDisplayPasswordFunction(password_cb);
fun normal_cb() { if (mode == "pin") { global.submitted = (bullets > 0); set_mode("wait"); } }
Plymouth.SetDisplayNormalFunction(normal_cb);
fun quit_cb() { refresh(); }
Plymouth.SetQuitFunction(quit_cb);

fun refresh() {
  dtk = 1 / FPS; global.tm += dtk; global.t_mode += dtk; global.t_err += dtk;
  if (mode == "intro" && tm > 0.6) set_mode("splash");
  if (mode == "wait" && t_mode > 0.9) { global.err = 0; set_mode("splash"); }

  # column: in 320 ms with an 8 px rise; out 240 ms (ease-in) once the answer is accepted
  if (mode == "pin" || mode == "wait") global.pin_op = clamp01(pin_op + dtk / 0.32); else global.pin_op = clamp01(pin_op - dtk / 0.24);
  if (mode == "splash" && pin_op <= 0) global.spl_op = clamp01(spl_op + dtk / 0.32); else global.spl_op = clamp01(spl_op - dtk / 0.24);
  if (mode == "pin" || mode == "wait") { po = ease(pin_op); rise = (1 - po) * 8 * U; } else { po = 1 - easein(1 - pin_op); rise = 0; }

  # ---- disk unlock column ----
  at(s_mark, i_mark, CX, CY + C_MARK * U + rise, po * 0.55);
  if (passmode) ti = i_tkey; else ti = i_tpin;
  at(s_title, ti, CX, CY + C_TITLE * U + rise, po);
  fy = CY + C_FLD * U + rise;
  at(s_fld, i_fld, CX, fy, po);
  # wrong answer: red border + hint for ~2.5 s, then both fade back over 240 ms (no shake)
  if (err) ek = 1 - clamp01((t_err - 2.5) / 0.24); else ek = 0;
  at(s_fld_err, i_fld_err, CX, fy, po * ek);
  if (passmode) hi = i_ekey; else hi = i_epin;
  at(s_hint, hi, CX, CY + C_HINT * U + rise, po * ek);
  if (passmode) fi = i_fkey; else fi = i_fpin;
  at(s_foot, fi, CX, Y0 + H - 24 * U - fi.GetHeight() / 2, po);

  # dots: 8 slots for a PIN (faint until typed), centred; a long recovery key just grows (capped to the field)
  nb = bullets; if (nb > 30) nb = 30;
  if (passmode) slots = nb; else { slots = 8; if (nb > 8) slots = nb; }
  gap = 16 * U; if (slots > 18) gap = 10 * U;
  x0 = CX - (slots - 1) * gap / 2;
  for (i = 0; i < slots; i++) {
    if (i >= ndots) { global.dots[i] = Sprite(i_dot); global.dots[i].SetZ(12); global.dt[i] = 0; global.ndots = i + 1; }
    if (i < nb) { global.dt[i] += dtk; dk = ease(dt[i] / 0.12); o = 0.14 + 0.86 * dk; r = (1 - dk) * 3 * U; }
    else { if (passmode) o = 0; else o = 0.14; r = 0; }
    at(dots[i], i_dot, x0 + i * gap, fy + r, po * o);
  }
  for (i = slots; i < ndots; i++) dots[i].SetOpacity(0);

  # ---- splash: mark, wordmark, indeterminate track (segment slides across every 1.6 s) ----
  so = ease(spl_op); sr = (1 - so) * 8 * U;
  at(s_mark42, i_mark42, CX, CY + SP_MARK * U + sr, so);
  at(s_word, i_word, CX, CY + SP_WORD * U + sr, so);
  ty = CY + SP_TRACK * U + sr; tx = CX - TRK_W * U / 2;
  s_track.SetImage(i_track.Scale(Math.Int(TRK_W * U), Math.Int(2 * U + 0.5))); s_track.SetX(Math.Int(tx)); s_track.SetY(Math.Int(ty)); s_track.SetOpacity(so);
  ph = (tm % 1.6) / 1.6; p = ease(ph);
  a = -SEG_W + (TRK_W + SEG_W) * p; b2 = a + SEG_W; if (a < 0) a = 0; if (b2 > TRK_W) b2 = TRK_W;
  if (b2 - a >= 1) { s_seg.SetImage(i_seg.Scale(Math.Int((b2 - a) * U), Math.Int(2 * U + 0.5))); s_seg.SetX(Math.Int(tx + a * U)); s_seg.SetY(Math.Int(ty)); s_seg.SetOpacity(so); }
  else s_seg.SetOpacity(0);
}
Plymouth.SetRefreshFunction(refresh);
